# Copy to .env and fill in. Never commit .env.

# Directory that holds data/raw. Defaults to ./data when unset.
MS_DATA_DIR=

# Contact string sent in the User-Agent of every outbound request, for example
# "MeridianSignal/0.1 (data pipeline; https://example.org/contact)". Required by NWS.
MS_CONTACT=

# Full User-Agent for api.weather.gov. When unset it is built from MS_CONTACT.
NWS_USER_AGENT=

# Free key from the NASA FIRMS "Get MAP_KEY" form.
FIRMS_MAP_KEY=

# Approved appname for the ReliefWeb API (optional source).
RELIEFWEB_APPNAME=

# Optional Hugging Face token for dataset downloads.
HF_TOKEN=

# PostgreSQL connection (local dev cluster: infra/postgres/dev_cluster.sh init).
DATABASE_URL=postgresql+psycopg://meridian:meridian@localhost:5433/meridian

# --- API (phase 5). Development generates keys into .local/secrets when these are empty. Production requires them. ---
# MS_ENV=development|test|production
MS_ENV=development
# Fernet key (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())") for secrets at rest.
MS_SECRET_KEY=
# Ed25519 private key in PEM form, newlines written as \n, used to sign access tokens.
MS_JWT_PRIVATE_KEY=
# Set to false only for local HTTP development.
MS_COOKIE_SECURE=true
# Valkey (Redis compatible) URL for shared rate limits and live streams; leave empty to use the in-process fallback.
MS_VALKEY_URL=
# Mail server for invitations and password resets (Mailpit in development).
MS_SMTP_HOST=localhost
MS_SMTP_PORT=1025
MS_PUBLIC_URL=http://localhost:3000

# --- Product workflows (phase 6) ---
# PDF reports use WeasyPrint (needs pango: brew install pango) and a headless browser for the map image
# (.venv/bin/playwright install chromium). On macOS the renderer looks in /opt/homebrew/lib; set this to override.
MS_PDF_LIB_PATH=
