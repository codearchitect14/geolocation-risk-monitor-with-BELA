# Copy to .env.prod and fill in. Never commit .env.prod.

# Public host name served by Caddy. Use localhost to try the stack locally (Caddy issues a certificate from its own authority).
SITE_ADDRESS=localhost

# Database password for the "meridian" role. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# Encrypts MFA seeds and webhook secrets at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MS_SECRET_KEY=
# Ed25519 private key (PEM) that signs access tokens, newlines written as \n.
# Generate: openssl genpkey -algorithm ed25519 | tr '\n' '|' | sed 's/|/\\n/g'
MS_JWT_PRIVATE_KEY=

# Outgoing mail for invitations, password resets, and alert mail. The application speaks plain SMTP without login or STARTTLS,
# so point it at a relay you run (for example a Postfix or Mailpit container on the private network). With no host set, mail
# attempts fail quietly (a warning in the log) and nothing is sent.
MS_SMTP_HOST=
MS_SMTP_PORT=587
MS_MAIL_FROM=no-reply@example.org

# Demonstration deployment: show the demo access box on the login page and name the read only viewer account.
DEMO_MODE=
DEMO_VIEWER=
